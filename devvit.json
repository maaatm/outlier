{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "playoutlier",

  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall",
        "styles": {
          "backgroundColor": "#2E9E6BFF",
          "backgroundColorDark": "#2E9E6BFF"
        }
      }
    }
  },

  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },

  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT", "SUBMIT_POST", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },

  "menu": {
    "items": [
      {
        "label": "Submit a question",
        "description": "Ask the subreddit something about ordinary behavior",
        "location": "subreddit",
        "forUserType": "user",
        "endpoint": "/internal/menu/submit-question"
      },
      {
        "label": "Outlier: review the question queue",
        "description": "Approve or reject community questions",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/review-queue"
      },
      {
        "label": "Outlier: post today's Daily now",
        "description": "Resolve and post the Daily without waiting for midnight",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-daily-now"
      },
      {
        "label": "Outlier: pin the menu post",
        "description": "Create and pin the how-to-play post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/pin-menu-post"
      },
      {
        "label": "Outlier: post the misjudged leaderboard",
        "description": "Publish the questions the subreddit read worst",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-leaderboard"
      },
      {
        "label": "Outlier: grant coins",
        "description": "Put coins in an account for testing the wardrobe",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/grant-coins"
      },
      {
        "label": "Outlier: wipe a player",
        "description": "Erase one account's record, votes and items — preview first",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/wipe-player"
      }
    ]
  },

  "forms": {
    "submitQuestion": "/internal/forms/submit-question",
    "reviewQueue": "/internal/forms/review-queue",
    "grantCoins": "/internal/forms/grant-coins",
    "wipePlayer": "/internal/forms/wipe-player"
  },

  "scheduler": {
    "tasks": {
      "post-daily": {
        "endpoint": "/internal/tasks/post-daily",
        "cron": "0 0 * * *"
      },
      "summarize-daily": {
        "endpoint": "/internal/tasks/summarize-daily",
        "cron": "0 0 * * *"
      },
      "refresh-queue": {
        "endpoint": "/internal/tasks/refresh-queue",
        "cron": "0 * * * *"
      },
      "sweep-comments": {
        "endpoint": "/internal/tasks/sweep-comments",
        "cron": "0 * * * *"
      }
    }
  },

  "triggers": {
    "onAppInstall": "/internal/triggers/install"
  },

  "dev": {
    "subreddit": "playoutlier_dev"
  },

  "scripts": {
    "dev": "npm run dev:build",
    "build": "npm run build"
  }
}
